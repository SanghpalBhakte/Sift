# ==============================================================================
# Sift Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# When Supabase variables are left empty or unset, Sift gracefully operates in
# local/offline mode with rich starter data so you can test immediately.
# ==============================================================================

# Supabase Public API Configuration (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key (NEVER expose to client - server side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (For auth callbacks and deep linking)
NEXT_PUBLIC_APP_URL=http://localhost:3000
